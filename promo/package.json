{
  "name": "cinderdeck-showcase",
  "version": "1.0.0",
  "description": "Cinderdeck 60-second animated product film",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "lucide-react": "1.50.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open --port=3417",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render Cinderdeck-Showcase out/cinderdeck-showcase.mp4 --codec=h264 --crf=17 --audio-bitrate=320k --pixel-format=yuv420p --color-space=bt709",
    "render:poster": "remotion still Cinderdeck-Showcase out/cinderdeck-showcase-poster.png --frame=130",
    "audio:generate": "node scripts/make-soundtrack.mjs",
    "render:gif": "node scripts/make-gif.mjs"
  }
}
