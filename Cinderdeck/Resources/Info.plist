<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleName</key>
	<string>$(CINDERDECK_BUNDLE_NAME)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.png</string>
				<string>public.jpeg</string>
				<string>public.heic</string>
				<string>public.heif</string>
				<string>public.tiff</string>
				<string>com.compuserve.gif</string>
				<string>org.webmproject.webp</string>
				<string>public.bmp</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ryancardin.cinderdeck</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cinderdeck</string>
				<string>snapzy</string>
			</array>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cinderdeck needs microphone access to record audio with your screen recordings.</string>
	<key>NSCameraUsageDescription</key>
	<string>Cinderdeck needs camera access to add a camera overlay to your screen recordings.</string>
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Cinderdeck needs screen recording permission to capture screenshots and record your screen.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/RyanCardin15/Cinderdeck/main/appcast.xml</string>
	<key>CinderdeckSignedUpdatesEnabled</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
</dict>
</plist>
